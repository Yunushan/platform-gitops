{
  "schema_version": 1,
  "runtime": "docker",
  "site_plan": {"replace_with_complete_reviewed_version_2_container_plan_from": "examples/gerrit-sites.json"},
  "member": "gerrit-a",
  "machine_id_sha256": "<SHA256_OF_MACHINE_ID_WITHOUT_TRAILING_NEWLINE>",
  "boot_id": "<CURRENT_HOST_BOOT_UUID>",
  "service_uid": 1000,
  "service_gid": 1000,
  "private_files_sha256": {
    "etc/secure.config": "<PRIVATE_SECURE_CONFIG_SHA256>",
    "etc/keystore": "<PRIVATE_KEYSTORE_SHA256>",
    "etc/ssh_host_ed25519_key": "<PRIVATE_SSH_HOST_KEY_SHA256>"
  },
  "health": {
    "address": "192.0.2.31",
    "hostname": "review.example.com",
    "ca_file": "/etc/gerrit-health-ca.crt",
    "ca_sha256": "<REVIEWED_HEALTH_CA_SHA256>"
  },
  "docker": {
    "binary": "/usr/bin/docker",
    "socket": "/var/run/docker.sock",
    "binary_sha256": "<REVIEWED_DOCKER_CLI_SHA256>",
    "daemon_id": "<ORIGINAL_DOCKER_ENGINE_ID>",
    "server_version": "<REVIEWED_EXACT_DOCKER_VERSION>",
    "image_id": "sha256:<PRELOADED_REVIEWED_IMAGE_ID>"
  },
  "native": null
}
