{
  "version": 1,
  "direction": "gitlab-to-forgejo",
  "source": {
    "api_url": "https://gitlab.example.test/api/v4",
    "token_env": "GITLAB_MIGRATION_TOKEN",
    "group_paths": [
      "engineering/platform"
    ],
    "project_paths": [
      "engineering/platform/control-plane"
    ],
    "usernames": [
      "alice",
      "bob"
    ],
    "all_available_projects": false,
    "all_available_groups": false
  },
  "destination": {
    "api_url": "https://forgejo.example.test/api/v1",
    "token_env": "FORGEJO_ADMIN_TOKEN",
    "owner_kind": "organization",
    "default_owner": "platform",
    "git_url_template": "ssh://git@forgejo.example.test/{owner}/{repo}.git"
  },
  "surfaces": {
    "users": {
      "mode": "managed",
      "default_password_env": "FORGEJO_IMPORTED_USER_PASSWORD",
      "placeholder_email_domain": "migration.invalid",
      "skip_bots": true,
      "include_members": true
    },
    "groups": {
      "mode": "managed",
      "members_mode": "import"
    },
    "subgroups": {
      "mode": "managed",
      "include_subgroups": true,
      "members_mode": "import"
    },
    "memberships": {
      "mode": "managed",
      "include_inherited": false,
      "include_expired": false,
      "pending_memberships": "skip",
      "unmapped_role": "fail",
      "role_mappings": {
        "0": "none",
        "5": "none",
        "10": {"permission": "read", "team": "gitlab-guests"},
        "15": {"permission": "read", "team": "gitlab-reporters"},
        "20": {"permission": "read", "team": "gitlab-reporters"},
        "25": {"permission": "read", "team": "gitlab-reporters"},
        "30": {"permission": "write", "team": "gitlab-developers"},
        "40": {"permission": "write", "team": "gitlab-maintainers"},
        "50": {"permission": "owner", "team": "Owners"},
        "60": {"permission": "owner", "team": "Owners"}
      },
      "custom_role_mappings": {
        "custom:12345": {"permission": "write", "team": "gitlab-custom-release"}
      }
    },
    "projects": {
      "mode": "managed"
    },
    "repositories": {
      "mode": "managed"
    },
    "permissions": {
      "mode": "managed",
      "include_direct": true,
      "include_inherited": true,
      "include_expired": false,
      "pending_memberships": "skip",
      "group_strategy": "both",
      "reconcile": "additive",
      "unmapped_role": "fail",
      "role_mappings": {
        "0": "none",
        "5": "none",
        "10": "read",
        "15": "read",
        "20": "read",
        "25": "read",
        "30": "write",
        "40": "write",
        "50": "admin",
        "60": "admin"
      },
      "custom_role_mappings": {
        "custom:12345": {"permission": "write", "team": "gitlab-custom-release"}
      }
    },
    "rules": {
      "mode": "managed",
      "reconcile": "additive",
      "gitlab_maintainer_team": "gitlab-maintainers"
    },
    "runners": {
      "mode": "mapped",
      "target": "woodpecker",
      "label_mappings": {
        "linux-amd64": {
          "platform": "linux",
          "arch": "amd64"
        }
      }
    },
    "variables": {
      "mode": "managed",
      "target": "woodpecker",
      "scopes": [
        "project",
        "group"
      ]
    },
    "ci": {
      "mode": "managed",
      "include_content": true,
      "source_globs": [
        ".gitlab-ci.yml",
        ".gitlab/ci/*.yml"
      ],
      "destination_mappings": {
        ".gitlab-ci.yml": ".woodpecker.yml"
      },
      "conversion": {
        "deployment_gate_marker": "FORGE_WORKSPACE_DEPLOYMENT_ENABLED"
      }
    },
    "pipelines": {
      "mode": "managed",
      "include_history": true,
      "include_schedules": true,
      "include_triggers": false,
      "import_history": false
    }
  },
  "services": {
    "woodpecker": {
      "api_url": "https://ci.example.test",
      "token_env": "WOODPECKER_ADMIN_TOKEN"
    }
  },
  "mappings": {
    "groups": {
      "engineering/platform": "platform"
    },
    "projects": {
      "engineering/platform/control-plane": {
        "owner": "platform",
        "repo": "control-plane",
        "owner_kind": "organization"
      }
    },
    "variables": {
      "project:DEPLOY_TOKEN:*": {
        "mode": "managed",
        "target_name": "DEPLOY_TOKEN"
      },
      "group:engineering/platform:REGISTRY_HOST:*": {
        "mode": "managed",
        "target_name": "REGISTRY_HOST"
      }
    }
  }
}
