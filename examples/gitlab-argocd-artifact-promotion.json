    "trusted_root": {"path": "/run/platform/promoter/trusted-root.json", "sha256": "REVIEWED_TRANSPARENCY_LOG_TRUST_SHA256"},
    "credential": {"path": "/run/platform/promoter/registry-pull.json", "sha256": "REVIEWED_PULL_CREDENTIAL_SHA256"}
  }
