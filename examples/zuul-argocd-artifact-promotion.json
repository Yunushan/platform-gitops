    "tenant": "platform",
    "pipeline": "platform-static-post",
    "project": "applications/example",
    "branch": "main",
    "uuid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "revision": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
