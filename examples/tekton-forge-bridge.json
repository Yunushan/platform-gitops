{
  "schema_version": 1,
  "name": "forge-push",
  "provider": "forgejo",
  "source": {
    "repository_id": 123,
    "repository": "team/application",
    "branch": "main",
    "read_username": "ci-read",
    "api_url": "https://forge.example.com/api/v1",
    "clone_url": "https://forge.example.com/team/application.git"
  },
  "management_target": {
    "kubeconfig_env": "PLATFORM_CI_KUBECONFIG",
    "context": "ci",
    "cluster_uid": "<REVIEWED_KUBE_SYSTEM_NAMESPACE_UID>"
  },
  "namespace": "platform-ci-jobs",
  "service_account": "application-build",
  "submitter_namespace": "platform-ci-control",
  "submitter_account": "forge-event-bridge",
  "node_selector": {
    "kubernetes.io/os": "linux",
    "platform.gitops/ci-worker": "true"
  },
  "controller_selector": {
    "kubernetes.io/os": "linux",
    "platform.gitops/control-service": "true"
  },
  "checkout_image": "registry.example.com/platform/git-python@sha256:<REVIEWED_IMAGE_DIGEST>",
  "build_image": "registry.example.com/platform/python@sha256:<REVIEWED_IMAGE_DIGEST>",
  "bridge_image": "registry.example.com/platform/python-kubectl@sha256:<REVIEWED_IMAGE_DIGEST>",
  "build_argv": ["python3", "-m", "unittest", "discover"],
  "read_secret": "application-read",
  "bridge_secret": "forge-event-inputs",
  "timeout_minutes": 10,
  "publish_address": "<PRIVATE_DOCKER_OR_NATIVE_IPV4>",
  "reporting": {
    "enabled": false,
    "account": "ci-result-reporter",
    "secret": "ci-result-inputs",
    "context": "ci/tekton/application",
    "poll_seconds": 30,
    "max_runs_per_poll": 25,
    "helper_images": []
  }
}
