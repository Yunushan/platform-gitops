# Copy this file to private/first-deploy.env and edit the private copy.
# private/first-deploy.env is ignored by git.

PLATFORM_REPO_URL=https://<PRIVATE_GIT_HOST>/<ORG>/platform-gitops-deploy.git
PLATFORM_REPO_USERNAME=<GIT_USERNAME>
PLATFORM_REPO_TOKEN=<GIT_READ_WRITE_TOKEN_FOR_BOOTSTRAP_REPO>

# Default profile for the first private deployment.
PLATFORM_PROFILE=premium-3node

# First bootstrap registers deployable apps and skips apps that still need
# private values such as backup buckets, database DSNs, or storage sizes.
# Use strict when all placeholders are resolved and you want fail-fast behavior.
PLATFORM_GITOPS_PLACEHOLDER_MODE=skip-incomplete

# Optional Git automation.
PLATFORM_DEPLOY_REMOTE_NAME=deploy
PLATFORM_DEPLOY_BRANCH=main
PLATFORM_AUTO_COMMIT=true
PLATFORM_AUTO_COMMIT_MESSAGE=Configure private platform deployment
PLATFORM_AUTO_PUSH=true

# Keep validation enabled unless you intentionally know why to skip it.
PLATFORM_VALIDATE_BEFORE_PUSH=true
PLATFORM_RUN_NO_SECRETS=true
