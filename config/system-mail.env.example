# Copy to private/system-mail.env; populated values must stay out of public Git.
# Dedicated env file for scripts/configure_system_mail.py (not a deployment env).
# This mode uses an unauthenticated IPv4 relay on TCP/25. If the relay requires
# authentication or mandatory TLS, review that setup separately; do not disable
# certificate verification or put SMTP credentials here.
PLATFORM_SMTP_HOST=<SMTP_RELAY_HOST>
PLATFORM_SMTP_PORT=25
PLATFORM_SYSTEM_EMAIL=<SYSTEM_MAILBOX>

# Compatible inputs for the existing Forgejo renderer. Preserve the complete
# private deployment environment; never re-render storage just to change mail.
FORGEJO_MAILER_ENABLED=true
FORGEJO_MAILER_PROTOCOL=smtp
FORGEJO_MAILER_HOST=<SMTP_RELAY_HOST>
FORGEJO_MAILER_PORT=25
FORGEJO_MAILER_FROM=<SYSTEM_MAILBOX>
