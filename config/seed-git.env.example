# Copy this file to private/seed-git.env and edit the private copy if needed.
# private/seed-git.env is ignored by git.

# First-deploy profile.
PLATFORM_PROFILE=premium-3node

# Temporary seed Git service location on the first RKE2 server.
PLATFORM_SEED_GIT_ROOT=/opt/platform/seed-git
PLATFORM_SEED_GIT_REPO_NAME=platform-gitops.git
PLATFORM_SEED_GIT_PORT=9418
PLATFORM_SEED_GIT_WAIT_TIMEOUT=45

# Optional. Usually auto-detected from inventory/hosts.local.ini.
# PLATFORM_SEED_GIT_OWNER=<SSH_USER>
# PLATFORM_SEED_PUSH_HOST=<NODE_1_IP_OR_DNS>
# PLATFORM_SEED_PUSH_USER=<SSH_USER>
# PLATFORM_SEED_READ_HOST=<NODE_1_IP_OR_DNS_REACHABLE_FROM_PODS>

# Optional Git automation.
PLATFORM_DEPLOY_BRANCH=main
PLATFORM_SEED_GIT_REMOTE_NAME=seed
PLATFORM_AUTO_COMMIT=true
PLATFORM_AUTO_COMMIT_MESSAGE=Configure private platform deployment

# Keep validation enabled unless you intentionally know why to skip it.
PLATFORM_VALIDATE_BEFORE_PUSH=true
PLATFORM_RUN_NO_SECRETS=true
