# Copy this file to private/seed-git.env and edit the private copy if needed.
# private/seed-git.env is ignored by git.

# First-deploy profile.
PLATFORM_PROFILE=premium-3node

# First bootstrap registers deployable apps and skips apps that still need
# private values such as backup buckets, database DSNs, or storage sizes.
# Use strict when all placeholders are resolved and you want fail-fast behavior.
PLATFORM_GITOPS_PLACEHOLDER_MODE=skip-incomplete

# First deploy repairs Kubernetes DNS/ClusterIP service routing before Argo CD
# waits on the controller. Keep enabled unless the cluster is already proven
# healthy and you want to save time.
PLATFORM_FIRST_DEPLOY_DNS_REPAIR=true
PLATFORM_FIRST_DEPLOY_ARGOCD_REPAIR_RETRY=true
PLATFORM_ARGOCD_SERVICE_PATH_FAST_FAIL_AFTER=90

# Render first-deploy private values before validation, commit, and seed push.
# The renderer can infer Forgejo from platform_forgejo_host/platform_git_host
# in inventory/hosts.local.ini, or you can set PLATFORM_FORGEJO_HOST here.
PLATFORM_AUTO_RENDER_PRIVATE_VALUES=true
FORGEJO_DATABASE_MODE=sqlite
FORGEJO_DATA_SIZE=20Gi
FORGEJO_STORAGE_CLASS=longhorn-critical
# PLATFORM_FORGEJO_HOST=<GIT_FQDN>
# LONGHORN_BACKUP_TARGET=

# Optional first-deploy bootstrap values for additional platform apps.
# These remove production-profile placeholders while keeping credentials out of
# git values. platform-app-secrets can create the referenced Kubernetes secrets
# from the ignored env values below.
# PLATFORM_ARGOCD_HOST=<ARGOCD_FQDN>
# PLATFORM_WOODPECKER_HOST=<CI_FQDN>
# PLATFORM_HARBOR_HOST=<REGISTRY_FQDN>
# PLATFORM_GRAFANA_HOST=<GRAFANA_FQDN>
# PLATFORM_PROMETHEUS_HOST=<PROMETHEUS_FQDN>
# PLATFORM_LOKI_HOST=<LOKI_FQDN>
WOODPECKER_DATA_SIZE=10Gi
WOODPECKER_STORAGE_CLASS=longhorn-standard
WOODPECKER_ADMIN_USERS=admin
WOODPECKER_FORGEJO_OAUTH_SECRET_NAME=woodpecker-forgejo-oauth
WOODPECKER_IMAGE_TAG=3.16.0
# First deploy defaults to SQLite with one Woodpecker server. For production HA,
# let platform-app-secrets create secret/woodpecker-database from either a full
# datasource or host/name/user/password pieces, then enable:
# WOODPECKER_DATABASE_MODE=postgres
# WOODPECKER_DATABASE_SECRET_NAME=woodpecker-database
# WOODPECKER_DATABASE_DATASOURCE=postgres://woodpecker:<PASSWORD>@<POSTGRES_HOST>:5432/woodpecker?sslmode=disable
# WOODPECKER_DATABASE_HOST=<POSTGRES_HOST>:5432
# WOODPECKER_DATABASE_NAME=woodpecker
# WOODPECKER_DATABASE_USER=woodpecker
# WOODPECKER_DATABASE_PASSWORD=<POSTGRES_PASSWORD>
# PLATFORM_APP_SECRET_REQUIRE_WOODPECKER_DATABASE=false
# WOODPECKER_SERVER_REPLICAS=2
# WOODPECKER_AGENT_REPLICAS=3
HARBOR_STORAGE_CLASS=longhorn-critical
HARBOR_REGISTRY_SIZE=50Gi
HARBOR_JOBLOG_SIZE=5Gi
HARBOR_DATABASE_SIZE=10Gi
HARBOR_REDIS_SIZE=5Gi
HARBOR_TRIVY_SIZE=10Gi
HARBOR_ADMIN_SECRET_NAME=harbor-admin
HARBOR_SECRET_KEY_SECRET_NAME=harbor-secret-key
MONITORING_STORAGE_CLASS=longhorn-standard
PROMETHEUS_RETENTION_SIZE=20GB
PROMETHEUS_DATA_SIZE=50Gi
ALERTMANAGER_DATA_SIZE=10Gi
GRAFANA_DATA_SIZE=10Gi
OBJECT_STORAGE_ENDPOINT=https://s3.amazonaws.com
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET_PREFIX=platform
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_INSECURE=false
LOKI_OBJECT_STORAGE_SECRET_NAME=loki-object-storage
LOKI_CHUNKS_BUCKET=platform-loki-chunks
LOKI_RULER_BUCKET=platform-loki-ruler
LOKI_ADMIN_BUCKET=platform-loki-admin
LOKI_WRITE_CACHE_SIZE=20Gi
LOKI_BACKEND_CACHE_SIZE=20Gi
LOKI_STORAGE_CLASS=longhorn-standard
BACKUP_PROVIDER=aws
BACKUP_BUCKET=platform-velero-backups
VELERO_CREDENTIALS_SECRET_NAME=velero-credentials
VELERO_DAILY_BACKUP_CRON="0 1 * * *"
CNPG_OBJECT_STORE_SECRET_NAME=cnpg-object-store
CNPG_BACKUP_DESTINATION=s3://platform-cnpg-backups/platform-postgres
CNPG_BACKUP_SCHEDULE="0 2 * * *"
CNPG_RENDER_POSTGRES_CLUSTER=false
# Set this true for production so missing Loki/Velero/CloudNativePG credentials fail early.
PLATFORM_APP_SECRET_REQUIRE_OBJECT_STORAGE=false
PLATFORM_APP_SECRET_REQUIRE_CNPG_OBJECT_STORAGE=false
# AWS_ACCESS_KEY_ID=<OBJECT_STORAGE_ACCESS_KEY>
# AWS_SECRET_ACCESS_KEY=<OBJECT_STORAGE_SECRET_KEY>
# LOKI_S3_ACCESS_KEY_ID=<LOKI_OBJECT_STORAGE_ACCESS_KEY>
# LOKI_S3_SECRET_ACCESS_KEY=<LOKI_OBJECT_STORAGE_SECRET_KEY>
# VELERO_CLOUD_CREDENTIALS=[default]\naws_access_key_id=<ACCESS_KEY>\naws_secret_access_key=<SECRET_KEY>
# CNPG_S3_ACCESS_KEY_ID=<CNPG_OBJECT_STORAGE_ACCESS_KEY>
# CNPG_S3_SECRET_ACCESS_KEY=<CNPG_OBJECT_STORAGE_SECRET_KEY>

# Temporary seed Git service location on the first RKE2 server.
PLATFORM_SEED_GIT_ROOT=/opt/platform/seed-git
PLATFORM_SEED_GIT_REPO_NAME=platform-gitops.git
PLATFORM_SEED_GIT_PORT=9418
PLATFORM_SEED_GIT_WAIT_TIMEOUT=45
PLATFORM_SEED_GIT_FORCE_WITH_LEASE=true

# Optional. Usually auto-detected from inventory/hosts.local.ini.
# PLATFORM_SEED_GIT_OWNER=<SSH_USER>
# PLATFORM_SEED_PUSH_HOST=<NODE_1_IP_OR_DNS>
# PLATFORM_SEED_PUSH_USER=<SSH_USER>
# PLATFORM_SEED_READ_HOST=<NODE_1_IP_OR_DNS_REACHABLE_FROM_PODS>

# Optional Git automation.
PLATFORM_DEPLOY_BRANCH=main
PLATFORM_SEED_GIT_REMOTE_NAME=seed
PLATFORM_SEED_SYNC_PULL=true
# Keep source remote push opt-in for private deployments cloned from a public
# template. Set true only when origin is your intended private deployment repo.
PLATFORM_SEED_SYNC_PUSH_ORIGIN=false
PLATFORM_AUTO_COMMIT=true
PLATFORM_AUTO_COMMIT_MESSAGE=Configure private platform deployment

# Keep validation enabled unless you intentionally know why to skip it.
PLATFORM_VALIDATE_BEFORE_PUSH=true
PLATFORM_RUN_PROFILE_CHECK=true
PLATFORM_RUN_NO_SECRETS=true
# Optional: set this when the bootstrap host has Python under a non-default name
# or path.
# PYTHON=/usr/bin/python3
# First seed deploys may render internal FQDNs into the temporary private seed
# repository. Keep this true for private seed deploys; leave unset/false for
# source remotes that might be public.
PLATFORM_NO_SECRETS_ALLOW_INTERNAL_HOSTNAMES=true
