# Copy this file to private/seed-git.env and edit the private copy if needed.
# private/seed-git.env is ignored by git.

# First-deploy profile.
PLATFORM_PROFILE=premium-3node
PLATFORM_PRODUCTION_STRICT=true
# Production evidence must exactly match this fetched, reviewed deployment ref.
PLATFORM_PRODUCTION_EVIDENCE_EXPECTED_REF=seed/main

# RKE2 control-plane disaster recovery. Credentials are reconciled into a
# kube-system Secret instead of being written into the RKE2 config file.
RKE2_ETCD_S3_ENABLED=true
RKE2_ETCD_S3_CONFIG_SECRET_NAME=rke2-etcd-snapshot-s3-config
RKE2_ETCD_SNAPSHOT_SCHEDULE_CRON="0 */6 * * *"
RKE2_ETCD_SNAPSHOT_RETENTION=56
RKE2_ETCD_S3_RETENTION=56
RKE2_ETCD_S3_ENDPOINT=s3.amazonaws.com
RKE2_ETCD_S3_BUCKET=platform-rke2-etcd
RKE2_ETCD_S3_REGION=us-east-1
RKE2_ETCD_S3_FOLDER=rke2-main
RKE2_ETCD_S3_INSECURE=false
RKE2_ETCD_S3_SKIP_SSL_VERIFY=false
# RKE2_ETCD_S3_ACCESS_KEY=<RKE2_ETCD_BACKUP_ACCESS_KEY>
# RKE2_ETCD_S3_SECRET_KEY=<RKE2_ETCD_BACKUP_SECRET_KEY>

# The production gate requires a recent, independently approved restore drill.
# Keep this JSON record in private/ or an equivalent ignored secure workspace.
PLATFORM_RESTORE_EVIDENCE_FILE=private/restore-evidence.json
PLATFORM_RESTORE_DRILL_MAX_AGE_DAYS=92
PLATFORM_FORGEJO_RECOVERY_EVIDENCE_FILE=private/forgejo-recovery-evidence.json
PLATFORM_FORGEJO_RECOVERY_MAX_AGE_DAYS=92
PLATFORM_FORGEJO_RECOVERY_MAX_RTO_SECONDS=300
# Drill-only, explicit approval values:
# PLATFORM_FORGEJO_RECOVERY_OPERATOR=<OPERATOR_ID>
# PLATFORM_FORGEJO_RECOVERY_APPROVER=<INDEPENDENT_APPROVER_ID>
# PLATFORM_FORGEJO_RECOVERY_CONFIRMATION=FAILOVER_FORGEJO_SINGLETON
PLATFORM_DATA_PROTECTION_MAX_ETCD_AGE_HOURS=8
PLATFORM_DATA_PROTECTION_MAX_BACKUP_AGE_HOURS=26

# First bootstrap registers deployable apps and skips apps that still need
# private values such as backup buckets, database DSNs, or storage sizes.
# Use strict when all placeholders are resolved and you want fail-fast behavior.
PLATFORM_GITOPS_PLACEHOLDER_MODE=skip-incomplete

# Normal app health checks load this file in bootstrap mode: temporary seed Git
# is accepted and only a verified initialized=false/sealed=true OpenBao server is
# allowed to await its private initialization ceremony. The production gate
# always overrides this mode and remains strict.
PLATFORM_APP_HEALTH_MODE=bootstrap

# First deploy repairs Kubernetes DNS/ClusterIP service routing before Argo CD
# waits on the controller. Keep enabled unless the cluster is already proven
# healthy and you want to save time.
PLATFORM_FIRST_DEPLOY_DNS_REPAIR=true
PLATFORM_FIRST_DEPLOY_ARGOCD_REPAIR_RETRY=true
PLATFORM_ARGOCD_SERVICE_PATH_FAST_FAIL_AFTER=90

# Render first-deploy private values before validation, commit, and seed push.
# The renderer can infer Forgejo from platform_forgejo_host/platform_git_host
# in inventory/hosts.local.ini, or you can set PLATFORM_FORGEJO_HOST here.
PLATFORM_AUTO_RENDER_PRIVATE_VALUES=true
# SQL selector for Forgejo.
# Default is PostgreSQL through the CloudNativePG service. Switch to sqlite,
# mysql, or mariadb only when that backend is intentional.
PLATFORM_SQL_DATABASE_MODE=postgres
FORGEJO_DATABASE_MODE=postgres
FORGEJO_DATABASE_HOST=platform-postgres-rw.platform-databases.svc.cluster.local:5432
FORGEJO_DATABASE_NAME=forgejo
FORGEJO_DATABASE_USER=forgejo
FORGEJO_DATABASE_SECRET_NAME=forgejo-database
FORGEJO_DATABASE_SSL_MODE=verify-full
FORGEJO_DATABASE_AUTO_GENERATE=true
# FORGEJO_DATABASE_MODE=sqlite
# FORGEJO_DATABASE_MODE=mysql
# FORGEJO_DATABASE_MODE=mariadb
# FORGEJO_DATABASE_HOST=<MYSQL_OR_MARIADB_HOST>:3306
# Premium default: Forgejo cache/queue uses the shared platform Valkey HA service.
FORGEJO_REDIS_MODE=redis
FORGEJO_REDIS_SECRET_NAME=forgejo-redis
# FORGEJO_REDIS_MODE=memory
# Production Forgejo stores attachments, LFS, avatars, and packages in S3.
# Strict mode rejects filesystem storage and cluster-local object-storage endpoints.
FORGEJO_OBJECT_STORAGE_MODE=s3
FORGEJO_S3_ENDPOINT=https://s3.amazonaws.com
FORGEJO_S3_REGION=us-east-1
FORGEJO_S3_BUCKET=platform-forgejo
FORGEJO_S3_SECRET_NAME=forgejo-object-storage
FORGEJO_S3_SECURE=true
PLATFORM_APP_SECRET_REQUIRE_FORGEJO_OBJECT_STORAGE=true
# FORGEJO_S3_ACCESS_KEY_ID=<FORGEJO_OBJECT_STORAGE_ACCESS_KEY>
# FORGEJO_S3_SECRET_ACCESS_KEY=<FORGEJO_OBJECT_STORAGE_SECRET_KEY>
# Lab-only alternative: PLATFORM_PRODUCTION_STRICT=false and
# FORGEJO_OBJECT_STORAGE_MODE=filesystem.
FORGEJO_DATA_SIZE=20Gi
FORGEJO_STORAGE_CLASS=longhorn-critical-encrypted
# PLATFORM_FORGEJO_HOST=<GIT_FQDN>
# Production requires an off-cluster Longhorn target. This bucket must exist in
# the external S3-compatible service selected below.
LONGHORN_BACKUP_TARGET=s3://platform-longhorn-backups@us-east-1/
LONGHORN_BACKUP_CREDENTIAL_SECRET_NAME=longhorn-backup-target
# This key unlocks every newly provisioned encrypted Longhorn volume. Preserve
# it outside the cluster in an encrypted recovery system; automatic rotation is
# intentionally unsupported because replacing it would strand existing data.
LONGHORN_ENCRYPTION_SECRET_NAME=longhorn-crypto
LONGHORN_ENCRYPTION_AUTO_GENERATE=true
LONGHORN_ENCRYPTION_RECOVERY_FILE=private/longhorn-encryption.key
# LONGHORN_ENCRYPTION_KEY=<RECOVERY_MANAGED_KEY>
# Keep 100 for reserved-capacity production storage. Raise only after reviewing
# physical usage, monitoring, and rebuild headroom.
PLATFORM_LONGHORN_STORAGE_OVER_PROVISIONING_PERCENTAGE=100

# Node-local cleanup is explicit and never deletes Longhorn replicas, snapshots,
# volume heads, PVCs, or mounted application data.
PLATFORM_NODE_STORAGE_CRI_PRUNE=true
PLATFORM_NODE_STORAGE_DNF_CLEAN=true
PLATFORM_NODE_STORAGE_TMPFILES_CLEAN=true
# PLATFORM_NODE_STORAGE_DOCKER_PRUNE=true
# PLATFORM_NODE_STORAGE_DOCKER_PRUNE_UNTIL=168h
# PLATFORM_NODE_STORAGE_JOURNAL_VACUUM_SIZE=2G

# Shared Redis-compatible cache for platform apps. Argo CD keeps its own Redis.
PLATFORM_VALKEY_AUTH_SECRET_NAME=platform-valkey-auth
PLATFORM_VALKEY_PASSWORD_KEY=valkey-password
PLATFORM_VALKEY_PRIMARY_HOST=platform-valkey-primary.platform-cache.svc.cluster.local
# Managed Valkey is TLS-only. Production-strict rendering rejects false.
FORGEJO_REDIS_TLS=true
PLATFORM_VALKEY_PORT=6379
PLATFORM_VALKEY_REPLICA_COUNT=3
PLATFORM_VALKEY_DATA_SIZE=8Gi
PLATFORM_VALKEY_STORAGE_CLASS=longhorn-critical-encrypted
PLATFORM_VALKEY_AUTO_GENERATE=true

# Optional first-deploy bootstrap values for additional platform apps.
# These remove production-profile placeholders while keeping credentials out of
# git values. platform-app-secrets can create the referenced Kubernetes secrets
# from the ignored env values below.
# PLATFORM_ARGOCD_HOST=<ARGOCD_FQDN>
# Keep local admin enabled until an OIDC or Dex login provider is configured and tested.
PLATFORM_ARGOCD_ADMIN_ENABLED=true
# PLATFORM_WOODPECKER_HOST=<CI_FQDN>
# PLATFORM_HARBOR_HOST=<REGISTRY_FQDN>
# PLATFORM_KEYCLOAK_HOST=<SSO_FQDN>
# PLATFORM_GRAFANA_HOST=<GRAFANA_FQDN>
# PLATFORM_PROMETHEUS_HOST=<PROMETHEUS_FQDN>
# PLATFORM_LOKI_HOST=<LOKI_FQDN>
WOODPECKER_DATA_SIZE=10Gi
WOODPECKER_STORAGE_CLASS=longhorn-standard-encrypted
# Keep false after onboarding. Set true only while approved Forgejo users
# register, or keep false and provision users through the Woodpecker admin flow.
WOODPECKER_OPEN=false
# Replace admin with the exact Forgejo login(s) that must be Woodpecker admins.
WOODPECKER_ADMIN_USERS=admin
WOODPECKER_FORGEJO_OAUTH_SECRET_NAME=woodpecker-forgejo-oauth
WOODPECKER_IMAGE_TAG=v3.16.0
WOODPECKER_LOG_LEVEL=info
WOODPECKER_DATABASE_MODE=postgres
WOODPECKER_DATABASE_SECRET_NAME=woodpecker-database
WOODPECKER_DATABASE_HOST=platform-postgres-rw.platform-databases.svc.cluster.local:5432
WOODPECKER_DATABASE_NAME=woodpecker
WOODPECKER_DATABASE_USER=woodpecker
WOODPECKER_DATABASE_SSLMODE=verify-full
WOODPECKER_DATABASE_SSLROOTCERT=/etc/ssl/platform-postgres/ca-certificates.crt
PLATFORM_APP_SECRET_REQUIRE_WOODPECKER_DATABASE=true
WOODPECKER_SERVER_REPLICAS=3
WOODPECKER_AGENT_REPLICAS=3
# For a small non-HA bootstrap, override:
# WOODPECKER_DATABASE_MODE=sqlite
# WOODPECKER_SERVER_REPLICAS=1
HARBOR_STORAGE_CLASS=longhorn-critical-encrypted
HARBOR_REGISTRY_SIZE=50Gi
HARBOR_JOBLOG_SIZE=5Gi
HARBOR_DATABASE_SIZE=10Gi
HARBOR_REDIS_SIZE=5Gi
HARBOR_TRIVY_SIZE=10Gi
HARBOR_ADMIN_SECRET_NAME=harbor-admin
HARBOR_SECRET_KEY_SECRET_NAME=harbor-secret-key
HARBOR_REPLICAS=2
HARBOR_DATABASE_MODE=external
HARBOR_DATABASE_HOST=platform-postgres-rw.platform-databases.svc.cluster.local
HARBOR_DATABASE_PORT=5432
HARBOR_DATABASE_NAME=registry
HARBOR_DATABASE_USER=harbor
HARBOR_DATABASE_SECRET_NAME=harbor-database
HARBOR_DATABASE_SSLMODE=verify-full
HARBOR_DATABASE_AUTO_GENERATE=true
HARBOR_REDIS_MODE=external
HARBOR_REDIS_ADDR=platform-valkey-primary.platform-cache.svc.cluster.local:6379
# Managed Valkey is TLS-only. Production-strict rendering rejects false.
HARBOR_REDIS_TLS=true
HARBOR_REDIS_SECRET_NAME=harbor-redis
HARBOR_STORAGE_MODE=s3
HARBOR_S3_BUCKET=platform-harbor-registry
HARBOR_S3_SECRET_NAME=harbor-registry-s3
PLATFORM_APP_SECRET_REQUIRE_HARBOR_DATABASE=true
PLATFORM_APP_SECRET_REQUIRE_HARBOR_REDIS=true
PLATFORM_APP_SECRET_REQUIRE_HARBOR_REGISTRY_STORAGE=true
# Internal database/Redis and filesystem storage are non-production options and
# require PLATFORM_PRODUCTION_STRICT=false plus HARBOR_REPLICAS=1.
# Central SSO for premium profile. Admin/database passwords are generated by
# platform-app-secrets unless you set the password variables below.
KEYCLOAK_ADMIN_SECRET_NAME=keycloak-admin
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_AUTO_GENERATE=true
# KEYCLOAK_ADMIN_PASSWORD=<KEYCLOAK_ADMIN_PASSWORD>
KEYCLOAK_DATABASE_HOST=platform-postgres-rw.platform-databases.svc.cluster.local
KEYCLOAK_DATABASE_PORT=5432
KEYCLOAK_DATABASE_NAME=keycloak
KEYCLOAK_DATABASE_USER=keycloak
KEYCLOAK_DATABASE_SECRET_NAME=keycloak-database
KEYCLOAK_DATABASE_SSL_MODE=verify-full
KEYCLOAK_DATABASE_AUTO_GENERATE=true
# KEYCLOAK_DATABASE_PASSWORD=<KEYCLOAK_DATABASE_PASSWORD>
KEYCLOAK_REPLICAS=2
KEYCLOAK_STORAGE_CLASS=longhorn-critical-encrypted
KEYCLOAK_IMAGE_REGISTRY=quay.io
KEYCLOAK_IMAGE_REPOSITORY=keycloak/keycloak
KEYCLOAK_IMAGE_TAG=26.7.0
KEYCLOAK_CONFIG_CLI_IMAGE_REGISTRY=quay.io
KEYCLOAK_CONFIG_CLI_IMAGE_REPOSITORY=adorsys/keycloak-config-cli
KEYCLOAK_CONFIG_CLI_IMAGE_TAG=6.5.1
# Production SSO is enabled by default. The bootstrap platform-admin user must
# enroll TOTP at first sign-in. All values below are generated if omitted.
PLATFORM_SSO_ENABLED=true
PLATFORM_SSO_REALM=platform
PLATFORM_SSO_BOOTSTRAP_ADMIN_USERNAME=platform-admin
PLATFORM_SSO_KEYCLOAK_SECRET_NAME=platform-sso-clients
PLATFORM_SSO_ARGOCD_SECRET_NAME=platform-sso-argocd
PLATFORM_SSO_GRAFANA_SECRET_NAME=platform-sso-grafana
PLATFORM_SSO_PROMETHEUS_SECRET_NAME=platform-sso-prometheus
# PLATFORM_SSO_BOOTSTRAP_ADMIN_PASSWORD=<BOOTSTRAP_PASSWORD>
# PLATFORM_SSO_ARGOCD_CLIENT_SECRET=<OIDC_CLIENT_SECRET>
# PLATFORM_SSO_GRAFANA_CLIENT_SECRET=<OIDC_CLIENT_SECRET>
# PLATFORM_SSO_PROMETHEUS_CLIENT_SECRET=<OIDC_CLIENT_SECRET>
# PLATFORM_SSO_PROMETHEUS_COOKIE_SECRET=<OAUTH2_PROXY_COOKIE_SECRET>
# Kubernetes API audit logging is enabled automatically with
# PLATFORM_PRODUCTION_STRICT=true. Values are in days, files, and MiB.
# Production must use an approved, immutable RKE2 release and reviewed installer.
# RKE2_VERSION=v1.36.2+rke2r1
# RKE2_INSTALL_SCRIPT_SHA256=<APPROVED_64_HEX_SHA256>
RKE2_AUDIT_POLICY_ENABLED=true
RKE2_AUDIT_LOG_MAXAGE=30
RKE2_AUDIT_LOG_MAXBACKUP=10
RKE2_AUDIT_LOG_MAXSIZE=100
# Verify every RKE2 server agrees that Kubernetes Secrets are encrypted at rest.
# Set false only for a time-bounded, approved legacy migration.
RKE2_VERIFY_SECRETS_ENCRYPTION=true
# Keep Kyverno policies in Audit while remediation is in progress. Enforce maps
# to the stable CEL Deny action and is safe only after the readiness gate is clean.
PLATFORM_POLICY_ENFORCEMENT=Audit
# Admission-time signature verification is intentionally disabled during the
# first public-template render. Promote to Audit after CI signs every image in
# the private registry, then to Enforce only after the live signed/unsigned
# canary passes. The public key is not secret, but its approval and rotation
# belong in the private release process.
PLATFORM_IMAGE_INTEGRITY_MODE=disabled
# PLATFORM_IMAGE_REGISTRY=<PRIVATE_REGISTRY_FQDN>
# PLATFORM_COSIGN_PUBLIC_KEY_FILE=/secure/path/platform-cosign.pub
# PLATFORM_COSIGN_REKOR_URL=https://rekor.sigstore.dev
# Production acceptance requires a real signed digest from the selected
# registry. The optional pull Secret must already exist in the canary namespace.
# PLATFORM_IMAGE_INTEGRITY_CANARY_IMAGE=<PRIVATE_REGISTRY>/<PROJECT>/<IMAGE>@sha256:<64_HEX_CHARACTERS>
PLATFORM_IMAGE_INTEGRITY_CANARY_NAMESPACE=kyverno
# PLATFORM_IMAGE_INTEGRITY_CANARY_PULL_SECRET=<REGISTRY_PULL_SECRET>
# Exact production reconciliation captures only sanitized Pod/container image
# identity, then requires every rendered and live digest to have signature and
# admission coverage. Copy the public example into the ignored private area.
# PLATFORM_IMAGE_INVENTORY_EXCEPTIONS_FILE=private/supply-chain/image-exceptions.json
PLATFORM_IMAGE_INVENTORY_MAX_AGE_HOURS=24
# Final acceptance writes a private, commit-bound record only after every live gate passes.
# Set distinct accountable identities before running `make platform-production-evidence`.
# PLATFORM_RELEASE_ID=change-2026-07-27
# PLATFORM_EVIDENCE_OPERATOR=operator@example.com
# PLATFORM_EVIDENCE_APPROVER=approver@example.com
PLATFORM_PRODUCTION_EVIDENCE_MAX_AGE_DAYS=7
# Independent live-acceptance approval. Keep the Cosign private key in the
# approver's protected KMS/HSM or offline workspace; only its public key belongs
# on the deployment controller. Pin the public-key digest through protected
# private configuration rather than deriving trust from the approval packet.
# PLATFORM_PRODUCTION_APPROVAL_FILE=private/production-evidence/<RELEASE>.approval.json
# PLATFORM_PRODUCTION_APPROVAL_BUNDLE_FILE=private/production-evidence/<RELEASE>.approval.sigstore.json
# PLATFORM_PRODUCTION_APPROVAL_PUBLIC_KEY_FILE=private/production-approver.pub
# PLATFORM_PRODUCTION_APPROVAL_PUBLIC_KEY_SHA256=<64_LOWERCASE_HEX_CHARACTERS>
# PLATFORM_PRODUCTION_APPROVAL_APPROVER=<INDEPENDENT_APPROVER_ID>
# Pre-issued wildcard certificate automation. These ignored local paths are read
# only by `make platform-tls`; the private key is removed from the server after
# namespace-local Kubernetes TLS Secrets are created.
# PLATFORM_WILDCARD_TLS_CERT_FILE=/secure/path/wildcard.crt
# PLATFORM_WILDCARD_TLS_KEY_FILE=/secure/path/wildcard.key
PLATFORM_WILDCARD_TLS_MIN_VALIDITY_DAYS=30
# Harbor uses the shared wildcard secret when its certificate source is secret.
HARBOR_TLS_CERT_SOURCE=secret
HARBOR_TLS_SECRET_NAME=harbor-tls
MONITORING_STORAGE_CLASS=longhorn-standard-encrypted
PROMETHEUS_RETENTION_SIZE=20GB
PROMETHEUS_DATA_SIZE=50Gi
ALERTMANAGER_DATA_SIZE=10Gi
ALERTMANAGER_CONFIG_SECRET_NAME=alertmanager-platform-config
PLATFORM_ALERTMANAGER_REQUIRE_ROUTE=true
# ALERTMANAGER_WEBHOOK_URL=https://alerts.example.test/platform
# ALERTMANAGER_CONFIG=<FULL_PRIVATE_ALERTMANAGER_YAML>
GRAFANA_DATA_SIZE=10Gi
GRAFANA_REPLICAS=2
GRAFANA_DATABASE_MODE=postgres
GRAFANA_DATABASE_HOST=platform-postgres-rw.platform-databases.svc.cluster.local
GRAFANA_DATABASE_PORT=5432
GRAFANA_DATABASE_NAME=grafana
GRAFANA_DATABASE_USER=grafana
GRAFANA_DATABASE_SECRET_NAME=grafana-database
GRAFANA_DATABASE_AUTO_GENERATE=true
GRAFANA_DATABASE_SSL_MODE=verify-full
PLATFORM_APP_SECRET_REQUIRE_GRAFANA_DATABASE=true
OBJECT_STORAGE_ENDPOINT=https://s3.amazonaws.com
# Backup workloads use this endpoint independently from application object
# storage. Production rendering rejects Kubernetes Service/cluster-local URLs.
BACKUP_OBJECT_STORAGE_ENDPOINT=https://s3.amazonaws.com
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET_PREFIX=platform
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_INSECURE=false
MINIO_ROOT_SECRET_NAME=minio-root
MINIO_ROOT_USER=platform-admin
MINIO_ROOT_AUTO_GENERATE=true
# MINIO_ROOT_PASSWORD=<MINIO_ROOT_PASSWORD>
MINIO_DATA_SIZE=50Gi
MINIO_STORAGE_CLASS=longhorn-critical-encrypted
MINIO_REPLICA_COUNT=4
MINIO_ZONES=1
MINIO_DRIVES_PER_NODE=1
LOKI_OBJECT_STORAGE_SECRET_NAME=loki-object-storage
LOKI_CHUNKS_BUCKET=platform-loki-chunks
LOKI_RULER_BUCKET=platform-loki-ruler
LOKI_ADMIN_BUCKET=platform-loki-admin
LOKI_WRITE_CACHE_SIZE=20Gi
LOKI_BACKEND_CACHE_SIZE=20Gi
LOKI_STORAGE_CLASS=longhorn-standard-encrypted
LOKI_RETENTION_PERIOD=720h
LOKI_GATEWAY_SECRET_NAME=loki-gateway-basic-auth
LOKI_CLIENT_SECRET_NAME=platform-loki-client
LOKI_GATEWAY_USERNAME=platform
# LOKI_GATEWAY_PASSWORD=<GENERATED_WHEN_OMITTED>
BACKUP_PROVIDER=aws
BACKUP_BUCKET=platform-velero-backups
VELERO_CREDENTIALS_SECRET_NAME=velero-credentials
VELERO_DAILY_BACKUP_CRON="0 1 * * *"
CNPG_OBJECT_STORE_SECRET_NAME=cnpg-object-store
CNPG_BACKUP_DESTINATION=s3://platform-cnpg-backups/platform-postgres
CNPG_BACKUP_SCHEDULE="0 2 * * *"
CNPG_RENDER_POSTGRES_CLUSTER=true
CNPG_BACKUP_ENABLED=true
CNPG_POSTGRES_IMAGE=ghcr.io/cloudnative-pg/postgresql:18.4-system-trixie
# Premium production fails early when any required object-storage credential is missing.
PLATFORM_APP_SECRET_REQUIRE_OBJECT_STORAGE=true
PLATFORM_APP_SECRET_REQUIRE_CNPG_OBJECT_STORAGE=true
PLATFORM_APP_SECRET_REQUIRE_LONGHORN_BACKUP=true
PLATFORM_APP_SECRET_REQUIRE_LONGHORN_ENCRYPTION=true
# AWS_ACCESS_KEY_ID=<OBJECT_STORAGE_ACCESS_KEY>
# AWS_SECRET_ACCESS_KEY=<OBJECT_STORAGE_SECRET_KEY>
# LOKI_S3_ACCESS_KEY_ID=<LOKI_OBJECT_STORAGE_ACCESS_KEY>
# LOKI_S3_SECRET_ACCESS_KEY=<LOKI_OBJECT_STORAGE_SECRET_KEY>
# VELERO_CLOUD_CREDENTIALS=[default]\naws_access_key_id=<ACCESS_KEY>\naws_secret_access_key=<SECRET_KEY>
# CNPG_S3_ACCESS_KEY_ID=<CNPG_OBJECT_STORAGE_ACCESS_KEY>
# CNPG_S3_SECRET_ACCESS_KEY=<CNPG_OBJECT_STORAGE_SECRET_KEY>
# HARBOR_S3_ACCESS_KEY_ID=<HARBOR_REGISTRY_ACCESS_KEY>
# HARBOR_S3_SECRET_ACCESS_KEY=<HARBOR_REGISTRY_SECRET_KEY>
# LONGHORN_BACKUP_ACCESS_KEY_ID=<LONGHORN_BACKUP_ACCESS_KEY>
# LONGHORN_BACKUP_SECRET_ACCESS_KEY=<LONGHORN_BACKUP_SECRET_KEY>

# Temporary seed Git service location on the first RKE2 server.
PLATFORM_SEED_GIT_ROOT=/opt/platform/seed-git
PLATFORM_SEED_GIT_REPO_NAME=platform-gitops.git
PLATFORM_SEED_GIT_PORT=9418
PLATFORM_SEED_GIT_WAIT_TIMEOUT=45
PLATFORM_SEED_GIT_FORCE_WITH_LEASE=true

# Optional. Usually auto-detected from inventory/hosts.local.ini.
# PLATFORM_SEED_GIT_OWNER=<SSH_USER>
# PLATFORM_SEED_PUSH_HOST=<NODE_1_IP_OR_DNS>
# PLATFORM_SEED_PUSH_USER=<SSH_USER>
# PLATFORM_SEED_READ_HOST=<NODE_1_IP_OR_DNS_REACHABLE_FROM_PODS>

# Optional Git automation.
PLATFORM_DEPLOY_BRANCH=main
PLATFORM_SEED_GIT_REMOTE_NAME=seed
PLATFORM_SEED_SYNC_PULL=true
# Keep source remote push opt-in for private deployments cloned from a public
# template. Set true only when origin is your intended private deployment repo.
PLATFORM_SEED_SYNC_PUSH_ORIGIN=false
PLATFORM_AUTO_COMMIT=true
PLATFORM_AUTO_COMMIT_MESSAGE=Configure private platform deployment

# Keep validation enabled unless you intentionally know why to skip it.
PLATFORM_VALIDATE_BEFORE_PUSH=true
PLATFORM_RUN_PROFILE_CHECK=true
PLATFORM_RUN_NO_SECRETS=true
# Optional: set this when the bootstrap host has Python under a non-default name
# or path.
# PYTHON=/usr/bin/python3
# First seed deploys may render internal FQDNs into the temporary private seed
# repository. Keep this true for private seed deploys; leave unset/false for
# source remotes that might be public.
PLATFORM_NO_SECRETS_ALLOW_INTERNAL_HOSTNAMES=true
